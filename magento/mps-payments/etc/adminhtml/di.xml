<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <!-- On every admin page while MPS is enabled for a store without an API key (Model\System\MissingApiKey). -->
    <type name="Magento\Framework\Notification\MessageList">
        <arguments>
            <argument name="messages" xsi:type="array">
                <item name="mps_payments_missing_api_key" xsi:type="string">Mps\Payments\Model\System\MissingApiKey</item>
            </argument>
        </arguments>
    </type>
</config>
