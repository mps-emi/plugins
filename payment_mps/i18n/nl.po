#: model:ir.model.fields.selection,name:payment_mps.selection__payment_provider__code__mps
#: model:payment.method,name:payment_mps.payment_method_mps
#: model:payment.provider,name:payment_mps.payment_provider_mps
msgid "MPS"
msgstr "MPS"

#. module: payment_mps
#: model:ir.model.fields,field_description:payment_mps.field_payment_provider__mps_has_api_key
msgid "MPS API Key Set"
msgstr "MPS API-sleutel ingevuld"

#. module: payment_mps
#: model:ir.model.fields,field_description:payment_mps.field_payment_transaction__mps_check_count
msgid "MPS Scheduled Reads"
msgstr "Geplande MPS-controles"

#. module: payment_mps
#: model:ir.model.fields,field_description:payment_mps.field_payment_provider__mps_is_test_key
msgid "MPS Test Key"
msgstr "MPS-testsleutel"

#. module: payment_mps
#. odoo-python
#: code:addons/payment_mps/models/payment_transaction.py:0
msgid ""
"MPS approved %(approved)s of %(requested)s %(currency)s: a partial approval."
" Check before delivering."
msgstr "MPS keurde %(approved)s van %(requested)s %(currency)s goed: een gedeeltelijke goedkeuring. Controleer dit voor u levert."

#. module: payment_mps
#. odoo-python
#: code:addons/payment_mps/models/payment_transaction.py:0
msgid ""
"MPS cannot refund this payment right now: it has not been paid yet, or this "
"refund is still being processed. Try again in a moment."
msgstr "MPS kan deze betaling nu niet terugbetalen: ze is nog niet betaald, of deze terugbetaling wordt nog verwerkt. Probeer het zo meteen opnieuw."

#. module: payment_mps
#. odoo-python
#: code:addons/payment_mps/models/payment_transaction.py:0
msgid ""
"MPS could not make the refund (%s). Nothing was refunded; you can refund "
"again."
msgstr "MPS kon de terugbetaling niet uitvoeren (%s). Er is niets terugbetaald; u kunt opnieuw terugbetalen."

#. module: payment_mps
#. odoo-python
#: code:addons/payment_mps/models/payment_provider.py:0
msgid "MPS did not accept these credentials (%s)."
msgstr "MPS heeft deze inloggegevens niet aanvaard (%s)."

#. module: payment_mps
#. odoo-python
#: code:addons/payment_mps/models/payment_transaction.py:0
msgid "MPS did not return a payment to send the shopper to."
msgstr "MPS gaf geen betaling terug om de klant naartoe te sturen."

#. module: payment_mps
#. odoo-python
#: code:addons/payment_mps/models/payment_transaction.py:0
msgid ""
"MPS does not know this payment for this API key. A test key refunds only "
"test payments, and a live key only live ones."
msgstr "MPS kent deze betaling niet voor deze API-sleutel. Een testsleutel betaalt alleen testbetalingen terug, een live sleutel alleen live betalingen."

#. module: payment_mps
#. odoo-python
#: code:addons/payment_mps/models/payment_transaction.py:0
msgid "MPS has not decided the refund yet. It is read again in a few minutes."
msgstr "MPS heeft nog niet over de terugbetaling beslist. Ze wordt over enkele minuten opnieuw opgevraagd."

#. module: payment_mps
#. odoo-python
#: code:addons/payment_mps/models/payment_transaction.py:0
msgid "MPS refused this refund (%s)."
msgstr "MPS weigerde deze terugbetaling (%s)."

#. module: payment_mps
#. odoo-python
#: code:addons/payment_mps/models/payment_transaction.py:0
msgid ""
"MPS refused this refund:\n"
"%s"
msgstr "MPS weigerde deze terugbetaling:\n%s"

#. module: payment_mps
#. odoo-python
#: code:addons/payment_mps/models/payment_provider.py:0
msgid "MPS rejected the API key."
msgstr "MPS heeft de API-sleutel geweigerd."

#. module: payment_mps
#. odoo-python
#: code:addons/payment_mps/models/payment_transaction.py:0
msgid ""
"MPS sends this refund after %(until)s (UTC). Until then it can still be "
"canceled in MPS."
msgstr "MPS verstuurt deze terugbetaling na %(until)s (UTC). Tot dan kan ze nog in MPS geannuleerd worden."

#. module: payment_mps
#: model_terms:ir.ui.view,arch_db:payment_mps.payment_provider_form
msgid ""
"Paste the API key from the MPS platform (Online › Get started) to enable or "
"publish this provider. MPS connects with an API key only: a client ID and "
"secret from an earlier setup are no longer used."
msgstr "Plak de API-sleutel uit het MPS-platform (Online › Aan de slag) om deze provider in te schakelen of te publiceren. MPS verbindt alleen nog met een API-sleutel: een client-ID en clientgeheim van een eerdere installatie worden niet meer gebruikt."

#. module: payment_mps
#: model:ir.model,name:payment_mps.model_payment_provider
msgid "Payment Provider"
msgstr ""

#. module: payment_mps
#: model:ir.module.module,shortdesc:base.module_payment_mps
msgid "Payment Provider: MPS"
msgstr "Betaalprovider: MPS"

#. module: payment_mps
#: model:ir.model,name:payment_mps.model_payment_transaction
msgid "Payment Transaction"
msgstr ""

#. module: payment_mps
#: model:ir.actions.server,name:payment_mps.cron_check_payments_ir_actions_server
msgid "Payment: Read Open MPS Payments"
msgstr "Betaling: open MPS-betalingen opvragen"

#. module: payment_mps
#: model:ir.model.fields,help:payment_mps.field_payment_provider__mps_webhook_secret
msgid ""
"Shown with your key in the MPS platform. Payment notifications are only "
"acted on when their signature matches; without a secret they are ignored and"
" orders are settled by the module's own checks."
msgstr "Staat bij uw sleutel in het MPS-platform. Betaalmeldingen worden alleen verwerkt als hun handtekening klopt; zonder geheim worden ze genegeerd en worden bestellingen afgehandeld door de eigen controles van de module."

#. module: payment_mps
#: model:ir.module.module,summary:base.module_payment_mps
msgid ""
"Take card and banking-app payments on the MPS-hosted checkout. Sends the "
"order amount, number and return addresses to MPS (Mobile Payment Solutions)."
msgstr "Ontvang betalingen met kaart en bankapp via de betaalpagina van MPS. Stuurt het bedrag, het nummer en de terugkeeradressen van de bestelling naar MPS (Mobile Payment Solutions)."

#. module: payment_mps
#. odoo-python
#: code:addons/payment_mps/models/payment_transaction.py:0
msgid "The payment failed at MPS."
msgstr "De betaling is mislukt bij MPS."

#. module: payment_mps
#. odoo-python
#: code:addons/payment_mps/models/payment_provider.py:0
msgid ""
"The payment provider rejected the request.\n"
"%s"
msgstr "De betaalprovider weigerde het verzoek.\n%s"

#. module: payment_mps
#. odoo-python
#: code:addons/payment_mps/models/payment_transaction.py:0
msgid "The refund %s cannot be read: its MPS payment is not known."
msgstr "De terugbetaling %s kan niet worden opgevraagd: de MPS-betaling ervan is niet bekend."

#. module: payment_mps
#. odoo-python
#: code:addons/payment_mps/models/payment_transaction.py:0
msgid "The refund was canceled in MPS. Nothing was refunded."
msgstr "De terugbetaling werd in MPS geannuleerd. Er is niets terugbetaald."

#. module: payment_mps
#. odoo-python
#: code:addons/payment_mps/models/payment_transaction.py:0
msgid "The shopper left the MPS checkout without paying."
msgstr "De klant verliet de betaalpagina van MPS zonder te betalen."

#. module: payment_mps
#: model:ir.model.fields,help:payment_mps.field_payment_provider__code
msgid "The technical code of this payment provider."
msgstr ""

#. module: payment_mps
#: model_terms:ir.ui.view,arch_db:payment_mps.payment_provider_form
msgid ""
"This is a test key. It accepts only the MPS test cards: no card is charged "
"and nothing is paid out."
msgstr "Dit is een testsleutel. Ze aanvaardt alleen de testkaarten van MPS: er wordt geen kaart gedebiteerd en er wordt niets uitbetaald."

#. module: payment_mps
#: model_terms:ir.ui.view,arch_db:payment_mps.payment_provider_form
msgid ""
"This payment method sends the order amount, order number and your shop's "
"return addresses to MPS (Mobile Payment Solutions) to open each payment."
msgstr "Deze betaalmethode stuurt het bedrag en het nummer van de bestelling en de terugkeeradressen van uw winkel naar MPS (Mobile Payment Solutions) om elke betaling te openen."

#. module: payment_mps
#: model:ir.model.fields,field_description:payment_mps.field_payment_provider__mps_webhook_secret
msgid "Webhook Signing Secret"
msgstr "Ondertekeningsgeheim voor webhooks"

#. module: payment_mps
#. odoo-python
#: code:addons/payment_mps/models/payment_transaction.py:0
msgid ""
"Your MPS API key may not make refunds: it lacks the payments:refund "
"permission. A production key holds it only when MPS granted it, so ask MPS "
"to grant it to this key. A test key always holds it."
msgstr "Uw MPS API-sleutel mag geen terugbetalingen doen: het recht payments:refund ontbreekt. Een productiesleutel heeft het alleen als MPS het toekende; vraag MPS het aan deze sleutel toe te kennen. Een testsleutel heeft het altijd."

#. module: payment_mps
#: model_terms:payment.provider,auth_msg:payment_mps.payment_provider_mps
msgid "Your payment has been authorized."
msgstr "Uw betaling is toegestaan."

#. module: payment_mps
#: model_terms:payment.provider,cancel_msg:payment_mps.payment_provider_mps
msgid "Your payment has been cancelled."
msgstr "Uw betaling is geannuleerd."

#. module: payment_mps
#: model_terms:payment.provider,pending_msg:payment_mps.payment_provider_mps
msgid "Your payment has been processed but is waiting for approval."
msgstr "Uw betaling is verwerkt maar wacht nog op goedkeuring."

#. module: payment_mps
#: model_terms:payment.provider,done_msg:payment_mps.payment_provider_mps
msgid "Your payment has been processed."
msgstr "Uw betaling is verwerkt."

#. module: payment_mps
#: model_terms:ir.ui.view,arch_db:payment_mps.payment_provider_form
msgid "mps_live_…"
msgstr "mps_live_…"

