#. module: payment_mps
#. odoo-python
#: code:addons/payment_mps/models/payment_provider.py:0
msgid ""
"Fill in the API key from the MPS platform (Online › Get started) before "
"enabling or publishing MPS. MPS connects with an API key only; a client ID "
"and secret are no longer used."
msgstr "Vul de API-sleutel uit het MPS-platform (Online › Aan de slag) in voordat u MPS inschakelt of publiceert. MPS verbindt alleen nog met een API-sleutel; een client-ID en clientgeheim worden niet meer gebruikt."

#. module: payment_mps
#: model:ir.model.fields,help:payment_mps.field_payment_provider__mps_api_key
msgid ""
"From the MPS platform, under Online › Get started. A test key starts with "
"mps_test_."
msgstr "Uit het MPS-platform, onder Online › Aan de slag. Een testsleutel begint met mps_test_."

#. module: payment_mps
#: model:ir.model.fields,field_description:payment_mps.field_payment_provider__mps_gateway_url
msgid "Gateway"
msgstr "Gateway"

#. module: payment_mps
#: model:ir.model.fields,help:payment_mps.field_payment_transaction__mps_check_count
msgid ""
"How many of the scheduled reads after opening the payment have been made."
msgstr "Hoeveel van de geplande controles na het openen van de betaling al gedaan zijn."

#. module: payment_mps
#: model:ir.model.fields,field_description:payment_mps.field_payment_provider__id
#: model:ir.model.fields,field_description:payment_mps.field_payment_transaction__id
msgid "ID"
msgstr ""

